{
  "name": "apilayer-saas-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A narrated, testable APILayer onboarding and dashboard demo",
  "engines": { "node": ">=22.14.0" },
  "scripts": {
    "demo": "node --import tsx src/demo.ts",
    "demo:live": "node --import tsx src/demo.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:live": "node --import tsx --test tests/integration.live.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": { "zod": "^4.1.12" },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
