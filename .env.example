# A unified APILayer account key with the five demo products enabled.
# Use .env for secrets, never the video, client-side code, or source control.
APILAYER_ACCESS_KEY=

# Enable only if your IPstack plan includes the security module.
IPSTACK_SECURITY=false
API_REQUEST_TIMEOUT_MS=10000

# Every demo uses real requests. Set deliberate inputs; there are no default identities.
# Mailboxlayer sends the email to APILayer and may probe the mail server via SMTP.
DEMO_EMAIL=
DEMO_IP=
DEMO_TICKER=AAPL
